; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LEPAS: Lakon Ciptoning"
config/description="Game Development Dinamik-21. Tema: Less is More, More is Worse. Arjuna mendaki Indrakila; setiap barang yang dibawa membesarkan bayangannya."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

general/default_playback_type.web=0

[autoload]

Bobot="*res://scripts/autoload/bobot.gd"
Game="*res://scripts/autoload/game.gd"
Music="*res://scripts/autoload/music.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/cormorant_garamond.ttf"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="hazard"
2d_physics/layer_4="zone"
2d_physics/layer_5="barang"
2d_physics/layer_6="musuh"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.05, 0.03, 1)
